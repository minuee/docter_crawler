low':'inherit','height':'auto'});\n\t\t\t\t\t\t$('#hd_layer_m').unbind('touchmove');\n\t\t\t\t\t});\n\t\t\t\t});\n\t\t\t}\n\t\t\thdalllayer();\n\n\t\t//카테고리 메뉴\n\t\t\t$('#hd_layer_m .layer_lnb ul li .icons').click(function() {\n\t\t\t\tvar thisa = $(this).parent('li');\n\t\t\t\tvar prts = $('#hd_layer_m .layer_lnb ul li');\n\t\t\t\tvar checkElement = thisa.next();\n\t\t\t\tif( (thisa.is('.on')) ) {\n\t\t\t\t\tthisa.removeClass(\"on\");\n\t\t\t\t} else {\n\t\t\t\t\tprts.removeClass(\"on\");\n\t\t\t\t\tthisa.addClass(\"on\");\n\t\t\t\t}\n\t\t\t});\n\n\t\thdheight();//상단 높이 조정\n\t\t$(window).resize(function () {\n\t\t\thdheight();//상단 높이 조정\n\t\t});\n\n\t\t// 메뉴\n\t$(function() {\n\n\t\t$(window).resize(function() {\n\t\t\tvar winW = window.outerWidth;\n\t\t\tvar clearH = $('#header .hd_center').height();\n\n\t\t\t$('#header .hd_wrpper').css('height', clearH);\n\t\t});\n\n\t\t$('#header').on('mouseenter', function() {\n\t\t\t$('#header').addClass('active');\n\t\t});\n\t\t$('#header .depth0 > li').on('mouseenter', function() {\n\t\t\t$(this).addClass('active');\n\t\t\t$('#header').addClass('active');\n\t\t\t$('#header .hd_wrpper').css({height: 485});\n\t\t\t$('.hd_dim').addClass('on');\n\t\t}).on('mouseleave', function() {\n\t\t\t$('#header .depth0').find('li').removeClass('active');\n\t\t\t$('#header .hd_wrpper').css({height: 85});\n\t\t\t$('.hd_dim').removeClass('on');\n\t\t});\n\t\t$('#header').on('mouseleave', function() {\n\t\t\tsetTimeout(function() {\n\t\t\t\t$('#header').removeClass('active');\n\t\t\t}, 100);\n\t\t});\n\n\t\t$('#lnbtab01 .layer_lnb > ul > li > a').on('click', function() {\n\t\t\t$(this).parents('li').toggleClass('on');\n\t\t\t$('#lnbtab01 .layer_lnb > ul > li').not($(this).parents('li')).removeClass('on');\n\t\t\treturn false;\n\t\t});\n\n\t});\n\t// 메뉴 끝\n\t//******공통 요소\n});\n</script>\n\n\n<div id=\"header_wrap\">\n\t<div id=\"header\" style=\"height: 85px;\">\n\t\t<div class=\"hd_wrpper\">\n\t\t\t<div class=\"hd_center clear\">\n\t\t\t\t<h1>